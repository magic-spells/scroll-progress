{
	"name": "@magic-spells/scroll-progress",
	"version": "1.0.0",
	"description": "High-performance scroll progress web component with configurable playhead anchors and optimized animations.",
	"author": "Cory Schulz",
	"license": "MIT",
	"type": "module",
	"main": "dist/scroll-progress.min.js",
	"module": "dist/scroll-progress.esm.js",
	"unpkg": "dist/scroll-progress.min.js",
	"exports": {
		".": {
			"import": "./dist/scroll-progress.esm.js",
			"default": "./dist/scroll-progress.esm.js"
		}
	},
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/magic-spells/scroll-progress"
	},
	"homepage": "https://github.com/magic-spells/scroll-progress#readme",
	"bugs": {
		"url": "https://github.com/magic-spells/scroll-progress/issues"
	},
	"keywords": [
		"scroll-progress",
		"web-components",
		"parallax",
		"scroll-animation",
		"custom-elements",
		"performance",
		"intersection-observer",
		"css-variables"
	],
	"files": [
		"dist/",
		"src/"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"prod": "vite build --watch",
		"lint": "eslint src/ eslint.config.js",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"eslint": "^9.38.0",
		"globals": "^15.15.0",
		"prettier": "^3.3.3",
		"vite": "^7.3.1"
	}
}
